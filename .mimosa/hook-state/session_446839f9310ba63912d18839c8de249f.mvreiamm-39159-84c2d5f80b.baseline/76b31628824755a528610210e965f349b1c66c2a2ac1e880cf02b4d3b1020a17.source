/**
 * Shared domain types for every MadarWA execution context.
 * These types are serialization contracts across the bridge, storage and UI.
 */

export type Language = "ar" | "en";
export type ThemeMode = "auto" | "light" | "dark";

export interface PrivacySettings {
  blurPreview: boolean;
  blurNames: boolean;
  blurAvatars: boolean;
  blurMessages: boolean;
  blurMedia: boolean;
  hidePresence: boolean;
  hideTyping: boolean;
  disableReadReceipts: boolean;
  disableAudioReceipts: boolean;
}

export interface AntiDeleteSettings {
  enabled: boolean;
  inChatToast: boolean;
  desktopNotification: boolean;
  maxCache: number;
}

export type RuleMatchType = "exact" | "contains" | "startsWith" | "regex" | "fallback";
export type RuleScope = "private" | "groups" | "all";

export interface AutoReplyRule {
  id: string;
  name: string;
  enabled: boolean;
  matchType: RuleMatchType;
  pattern: string;
  response: string;
  scope: RuleScope;
  cooldownMinutes: number;
  typingSeconds: number;
}

export interface QuickTemplate {
  id: string;
  label: string;
  text: string;
}

export interface AutoReplySettings {
  enabled: boolean;
  rules: AutoReplyRule[];
  templates: QuickTemplate[];
}

export interface BroadcasterSettings {
  minDelaySec: number;
  maxDelaySec: number;
  batchSize: number;
  batchCooldownSec: number;
  randomizeWithSpintax: boolean;
  validateNumbers: boolean;
  defaultCountryCode: string;
}

export interface WebhookSettings {
  enabled: boolean;
  url: string;
  secret: string;
  forwardMessages: boolean;
  forwardRevoked: boolean;
}

export interface PinSettings {
  enabled: boolean;
  hash: string;
  salt: string;
  idleMinutes: number;
}

export interface AppSettings {
  version: number;
  language: Language;
  theme: ThemeMode;
  enabled: boolean;
  privacy: PrivacySettings;
  antiDelete: AntiDeleteSettings;
  autoReply: AutoReplySettings;
  broadcaster: BroadcasterSettings;
  webhook: WebhookSettings;
  pin: PinSettings;
  defaultCountryCode: string;
  updatedAt: number;
}

export interface CachedMessage {
  id: string;
  chatId: string;
  chatName: string;
  sender: string;
  senderName: string;
  text: string;
  messageType: string;
  timestamp: number;
}

export interface DeletedMessage extends CachedMessage {
  revokedAt: number;
  revokedBy: string;
  revokeType: string;
  recoveredFromCache: boolean;
}

export interface GroupSummary {
  id: string;
  name: string;
  participantsCount: number;
}

export interface ContactRow {
  id: string;
  phone: string;
  name: string;
  isMyContact: boolean;
}

export interface GroupParticipantRow extends ContactRow {
  isAdmin: boolean;
  isSuperAdmin: boolean;
  groupId: string;
  groupName: string;
}

export type RecipientStatus = "pending" | "sending" | "sent" | "failed" | "invalid" | "skipped";

export interface CampaignRecipient {
  phone: string;
  chatId: string;
  name: string;
  custom1: string;
  custom2: string;
  status: RecipientStatus;
  reason: string;
}

export type CampaignStatus = "idle" | "running" | "paused" | "stopped" | "completed";

export interface CampaignLogEntry {
  index: number;
  phone: string;
  status: RecipientStatus;
  detail: string;
  at: number;
}

export interface CampaignState {
  id: string;
  status: CampaignStatus;
  total: number;
  processed: number;
  sent: number;
  failed: number;
  invalid: number;
  startedAt: number;
  finishedAt: number;
  logs: CampaignLogEntry[];
}

export interface WebhookLogEntry {
  id: string;
  at: number;
  url: string;
  ok: boolean;
  status: number;
  error: string;
  event: string;
}

export interface EngineInfo {
  ready: boolean;
  wppVersion: string;
  me: string;
  connected: boolean;
}

export interface IncomingMessageEvent {
  id: string;
  chatId: string;
  chatName: string;
  sender: string;
  senderName: string;
  text: string;
  messageType: string;
  timestamp: number;
  isGroup: boolean;
  fromMe: boolean;
}

export interface RevokedMessageEvent {
  refId: string;
  chatId: string;
  chatName: string;
  author: string;
  revokedBy: string;
  revokeType: string;
  timestamp: number;
  isGroup: boolean;
}

export interface PresenceEvent {
  chatId: string;
  isOnline: boolean;
  state: string;
  shortName: string;
  isGroup: boolean;
}

export interface AutoReplySentEvent {
  chatId: string;
  ruleId: string;
  ruleName: string;
  text: string;
  at: number;
}

export interface EngineReadyEvent {
  ready: boolean;
  wppVersion: string;
  me: string;
}

export interface BridgeErrorShape {
  code: string;
  message: string;
}

export interface EnginePingResult extends EngineInfo {
  engineVersion: string;
  supportedWhatsappWeb: string;
}

export interface SendResult {
  id: string;
  ack?: number;
  timestamp?: number;
}

export interface ValidationResult {
  input: string;
  exists: boolean;
  chatId: string;
  error: string;
}

export interface WebhookPayload {
  event: "message" | "revoked" | "test";
  source: "madarwa";
  at: number;
  data: Record<string, unknown>;
}
