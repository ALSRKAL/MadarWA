import { BRIDGE, ENGINE_VERSION } from "../constants";
import { timingSafeEqual } from "../utils/security";
import {
  BRIDGE_NS,
  BRIDGE_VERSION,
  BridgeProtocolError,
  decodeEnvelope,
  encodeEnvelope,
  isEventPayload,
  isHandshake,
  isRequestPayload,
  isResponsePayload,
  randomToken,
  type Handshake,
  type ResponsePayload,
} from "./protocol";

export interface BridgeEngineOptions {
  target?: Window;
  origin?: string;
  commandHandler: (cmd: string, params: unknown) => Promise<unknown> | unknown;
}

interface Session {
  sid: string;
  key: string;
}

function dispatch(target: Window, name: string, payload: unknown): void {
  const detail = typeof payload === "string" ? payload : JSON.stringify(payload);
  target.dispatchEvent(new CustomEvent(name, { detail }));
}

function readDetail(event: Event): unknown {
  const detail = (event as CustomEvent<unknown>).detail;
  if (typeof detail === "string") {
    try {
      return JSON.parse(detail);
    } catch {
      return null;
    }
  }
  return null;
}

/**
 * MAIN-world side of the bridge. It accepts a single ephemeral session from
 * the ISOLATED world, rejects replayed sequence numbers and never throws
 * across the event boundary — every failure is serialized as an error result.
 */
export class BridgeEngine {
  private readonly target: Window;
  private readonly origin: string;
  private readonly commandHandler: BridgeEngineOptions["commandHandler"];
  private session: Session | null = null;
  private outSeq = 0;
  private lastInSeq = 0;
  private disposed = false;

  constructor(options: BridgeEngineOptions) {
    this.target = options.target ?? window;
    this.origin = options.origin ?? this.target.location?.origin ?? "";
    this.commandHandler = options.commandHandler;
    this.target.addEventListener(BRIDGE.handshake, this.handleHandshake as EventListener);
    this.target.addEventListener(BRIDGE.commandRequest, this.handleCommand as EventListener);
  }

  hasSession(): boolean {
    return this.session !== null;
  }

  sessionId(): string {
    return this.session?.sid ?? "";
  }

  private handleHandshake = (event: Event): void => {
    if (this.disposed) return;
    if (!this.session) {
      const parsed = readDetail(event);
      if (!isHandshake(parsed, this.origin)) return;
      this.session = { sid: parsed.sid, key: parsed.key };
      this.lastInSeq = 0;
      this.outSeq = 0;
      this.sendAck(parsed, true);
      return;
    }

    const parsed = readDetail(event);
    if (!isHandshake(parsed, this.origin)) return;

    if (parsed.sid !== this.session.sid) {
      // A new page/session supersedes the old one.
      this.session = { sid: parsed.sid, key: parsed.key };
      this.lastInSeq = 0;
      this.outSeq = 0;
    }
    this.sendAck(parsed, false);
  };

  private sendAck(handshake: Handshake, initial: boolean): void {
    const ack = {
      v: BRIDGE_VERSION,
      ns: BRIDGE_NS,
      sid: handshake.sid,
      engine: ENGINE_VERSION,
      initial,
    };
    dispatch(this.target, BRIDGE.handshakeAck, ack);
  }

  private handleCommand = (event: Event): void => {
    if (this.disposed || !this.session) return;

    let decoded: ReturnType<typeof decodeEnvelope>;
    try {
      decoded = decodeEnvelope(this.session.key, this.session.sid, (event as CustomEvent<unknown>).detail);
    } catch {
      return;
    }
    if (decoded.kind !== "req") return;
    if (decoded.seq <= this.lastInSeq) return;
    this.lastInSeq = decoded.seq;

    if (!isRequestPayload(decoded.payload)) {
      this.respond({ reqId: "", ok: false, error: { code: "BAD_REQUEST", message: "Malformed request payload" } });
      return;
    }

    const { reqId, cmd, params } = decoded.payload;
    void Promise.resolve()
      .then(() => this.commandHandler(cmd, params))
      .then((result) => this.respond({ reqId, ok: true, result }))
      .catch((error: unknown) => {
        const shaped = error as { code?: unknown; message?: unknown };
        const code = typeof shaped?.code === "string" ? shaped.code : "ENGINE_ERROR";
        const message = typeof shaped?.message === "string" ? shaped.message.slice(0, 800) : "Command failed";
        this.respond({ reqId, ok: false, error: { code, message } });
      });
  };

  private respond(payload: ResponsePayload): void {
    if (!this.session) return;
    this.outSeq += 1;
    const raw = encodeEnvelope(this.session.key, this.session.sid, this.outSeq, "res", payload);
    dispatch(this.target, BRIDGE.commandResponse, raw);
  }

  /** Broadcast an encrypted engine event to the ISOLATED world. */
  emit(event: string, data: unknown): void {
    if (!this.session) return;
    this.outSeq += 1;
    const raw = encodeEnvelope(this.session.key, this.session.sid, this.outSeq, "evt", {
      event,
      data,
      ts: Date.now(),
    });
    dispatch(this.target, BRIDGE.eventStream, raw);
  }

  /** Plaintext readiness signal; no secrets are exposed. */
  announceReady(info: { ready: boolean; wppVersion: string; me: string }): void {
    if (!this.session) return;
    dispatch(this.target, BRIDGE.engineReady, {
      v: BRIDGE_VERSION,
      ns: BRIDGE_NS,
      sid: this.session.sid,
      ...info,
    });
  }

  dispose(): void {
    this.disposed = true;
    this.target.removeEventListener(BRIDGE.handshake, this.handleHandshake as EventListener);
    this.target.removeEventListener(BRIDGE.commandRequest, this.handleCommand as EventListener);
    this.session = null;
  }
}

export interface BridgeClientOptions {
  target?: Window;
  origin?: string;
  handshakeRetryMs?: number;
  steadyHandshakeMs?: number;
  requestTimeoutMs?: number;
  sessionFactory?: () => { sid: string; key: string };
}

interface PendingRequest {
  resolve: (value: unknown) => void;
  reject: (error: Error) => void;
  timer: ReturnType<typeof setTimeout>;
  cmd: string;
}

interface ReadyWaiter {
  resolve: () => void;
  reject: (error: Error) => void;
  timer: ReturnType<typeof setTimeout>;
}

/**
 * ISOLATED-world side of the bridge. Maintains a page-scoped session and
 * re-establishes it automatically if the MAIN engine or extension reloads.
 */
export class BridgeClient {
  private readonly target: Window;
  private readonly origin: string;
  private readonly retryMs: number;
  private readonly steadyMs: number;
  private readonly defaultTimeoutMs: number;
  private readonly sessionFactory: () => { sid: string; key: string };
  private session: { sid: string; key: string } | null = null;
  private seq = 0;
  private connected = false;
  private lastAckAt = 0;
  private started = false;
  private disposed = false;
  private timer: ReturnType<typeof setInterval> | null = null;
  private readonly pending = new Map<string, PendingRequest>();
  private readonly readyWaiters: ReadyWaiter[] = [];
  private readonly eventListeners = new Set<(event: string, data: unknown) => void>();
  private readonly connectionListeners = new Set<(connected: boolean) => void>();

  constructor(options: BridgeClientOptions = {}) {
    this.target = options.target ?? window;
    this.origin = options.origin ?? this.target.location?.origin ?? "";
    this.retryMs = options.handshakeRetryMs ?? BRIDGE.handshakeRetryMs;
    this.steadyMs = options.steadyHandshakeMs ?? 3000;
    this.defaultTimeoutMs = options.requestTimeoutMs ?? BRIDGE.requestTimeoutMs;
    this.sessionFactory = options.sessionFactory ?? (() => ({ sid: randomToken(16), key: randomToken(32) }));
    this.target.addEventListener(BRIDGE.handshakeAck, this.handleAck as EventListener);
    this.target.addEventListener(BRIDGE.commandResponse, this.handleResponse as EventListener);
    this.target.addEventListener(BRIDGE.eventStream, this.handleEvent as EventListener);
  }

  start(): void {
    if (this.started || this.disposed) return;
    this.started = true;
    this.session = this.sessionFactory();
    this.sendHandshake();
    this.timer = setInterval(() => this.tick(), this.retryMs);
  }

  isConnected(): boolean {
    return this.connected;
  }

  sessionId(): string {
    return this.session?.sid ?? "";
  }

  private tick(): void {
    if (this.disposed) return;
    const now = Date.now();
    if (this.connected && now - this.lastAckAt > 15_000) {
      this.setConnected(false);
    }
    if (this.connected) {
      if (now - this.lastAckAt > this.steadyMs) this.sendHandshake();
      return;
    }
    this.sendHandshake();
  }

  private sendHandshake(): void {
    if (!this.session || this.disposed) return;
    dispatch(this.target, BRIDGE.handshake, {
      v: BRIDGE_VERSION,
      ns: BRIDGE_NS,
      sid: this.session.sid,
      key: this.session.key,
      ts: Date.now(),
      origin: this.origin,
    } satisfies Handshake);
  }

  private handleAck = (event: Event): void => {
    if (this.disposed) return;
    const parsed = readDetail(event) as { sid?: unknown } | null;
    if (!parsed || parsed.sid !== this.session?.sid) return;
    this.lastAckAt = Date.now();
    if (!this.connected) this.setConnected(true);
  };

  private setConnected(value: boolean): void {
    if (this.connected === value) return;
    this.connected = value;
    for (const listener of [...this.connectionListeners]) listener(value);
    if (value) {
      const waiters = this.readyWaiters.splice(0);
      for (const waiter of waiters) {
        clearTimeout(waiter.timer);
        waiter.resolve();
      }
    }
  }

  private handleResponse = (event: Event): void => {
    if (this.disposed || !this.session) return;
    let decoded: ReturnType<typeof decodeEnvelope>;
    try {
      decoded = decodeEnvelope(this.session.key, this.session.sid, (event as CustomEvent<unknown>).detail);
    } catch {
      return;
    }
    if (decoded.kind !== "res" || !isResponsePayload(decoded.payload)) return;
    const payload = decoded.payload;
    const entry = this.pending.get(payload.reqId);
    if (!entry) return;
    this.pending.delete(payload.reqId);
    clearTimeout(entry.timer);

    if (payload.ok) {
      entry.resolve(payload.result);
    } else {
      const code = payload.error?.code ?? "ENGINE_ERROR";
      const message = payload.error?.message ?? "Engine command failed";
      entry.reject(new BridgeProtocolError(code, message));
    }
  };

  private handleEvent = (event: Event): void => {
    if (this.disposed || !this.session) return;
    let decoded: ReturnType<typeof decodeEnvelope>;
    try {
      decoded = decodeEnvelope(this.session.key, this.session.sid, (event as CustomEvent<unknown>).detail);
    } catch {
      return;
    }
    if (decoded.kind !== "evt" || !isEventPayload(decoded.payload)) return;
    for (const listener of [...this.eventListeners]) {
      try {
        listener(decoded.payload.event, decoded.payload.data);
      } catch {
        // A broken UI listener must not break the bridge.
      }
    }
  };

  request<T>(cmd: string, params: unknown = {}, timeoutMs?: number): Promise<T> {
    if (this.disposed) return Promise.reject(new BridgeProtocolError("DISPOSED", "Bridge client disposed"));
    if (!this.session) return Promise.reject(new BridgeProtocolError("NOT_STARTED", "Bridge client not started"));
    if (!this.connected) {
      return Promise.reject(new BridgeProtocolError("UNAVAILABLE", "MadarWA engine is not connected"));
    }

    const reqId = randomToken(8);
    this.seq += 1;
    const raw = encodeEnvelope(this.session.key, this.session.sid, this.seq, "req", {
      reqId,
      cmd,
      params,
      ts: Date.now(),
    });

    const timeout = timeoutMs ?? this.defaultTimeoutMs;
    return new Promise<T>((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(reqId);
        reject(new BridgeProtocolError("TIMEOUT", `Command timed out: ${cmd}`));
      }, timeout);

      this.pending.set(reqId, {
        resolve: resolve as (value: unknown) => void,
        reject,
        timer,
        cmd,
      });
      dispatch(this.target, BRIDGE.commandRequest, raw);
    });
  }

  onEvent(listener: (event: string, data: unknown) => void): () => void {
    this.eventListeners.add(listener);
    return () => this.eventListeners.delete(listener);
  }

  onConnectionChange(listener: (connected: boolean) => void): () => void {
    this.connectionListeners.add(listener);
    return () => this.connectionListeners.delete(listener);
  }

  waitForReady(timeoutMs = 15_000): Promise<void> {
    if (this.connected) return Promise.resolve();
    return new Promise<void>((resolve, reject) => {
      const timer = setTimeout(() => {
        const index = this.readyWaiters.findIndex((waiter) => waiter.timer === timer);
        if (index >= 0) this.readyWaiters.splice(index, 1);
        reject(new BridgeProtocolError("UNAVAILABLE", "MadarWA engine did not become ready"));
      }, timeoutMs);
      this.readyWaiters.push({ resolve, reject, timer });
    });
  }

  dispose(): void {
    this.disposed = true;
    if (this.timer) clearInterval(this.timer);
    this.timer = null;
    for (const [, entry] of this.pending) {
      clearTimeout(entry.timer);
      entry.reject(new BridgeProtocolError("DISPOSED", `Command aborted: ${entry.cmd}`));
    }
    this.pending.clear();
    for (const waiter of this.readyWaiters.splice(0)) {
      clearTimeout(waiter.timer);
      waiter.reject(new BridgeProtocolError("DISPOSED", "Bridge disposed"));
    }
    this.target.removeEventListener(BRIDGE.handshakeAck, this.handleAck as EventListener);
    this.target.removeEventListener(BRIDGE.commandResponse, this.handleResponse as EventListener);
    this.target.removeEventListener(BRIDGE.eventStream, this.handleEvent as EventListener);
  }
}

export { BridgeProtocolError, timingSafeEqual };
