/**
 * Webhook URL hardening.
 *
 * The service worker fetches user-supplied URLs, so this validator blocks
 * non-HTTP schemes, embedded credentials, localhost, private/reserved IP
 * ranges and single-label intranet hostnames. It cannot defeat DNS rebinding
 * inside a browser extension; the host allow-list expectation is documented.
 */

export interface UrlValidation {
  ok: boolean;
  url: string;
  reason: string;
  code: string;
}

function fail(code: string, reason: string): UrlValidation {
  return { ok: false, url: "", reason, code };
}

function parseIpv4(host: string): number[] | null {
  const parts = host.split(".");
  if (parts.length !== 4) return null;
  const octets: number[] = [];
  for (const part of parts) {
    if (!/^\d{1,3}$/.test(part)) return null;
    const value = Number(part);
    if (value < 0 || value > 255) return null;
    octets.push(value);
  }
  return octets;
}

function isPrivateIpv4(octets: number[]): boolean {
  const [a = 0, b = 0] = octets;
  if (a === 0) return true;
  if (a === 10) return true;
  if (a === 127) return true;
  if (a === 169 && b === 254) return true;
  if (a === 172 && b >= 16 && b <= 31) return true;
  if (a === 192 && b === 168) return true;
  if (a === 100 && b >= 64 && b <= 127) return true;
  if (a === 192 && b === 0) return true;
  if (a === 192 && b === 0 && octets[2] === 2) return true;
  if (a === 198 && (b === 18 || b === 19)) return true;
  if (a === 198 && b === 51 && octets[2] === 100) return true;
  if (a === 203 && b === 0 && octets[2] === 113) return true;
  if (a >= 224) return true;
  return false;
}

function embeddedIpv4(host: string): number[] | null {
  const lastColon = host.lastIndexOf(":");
  if (lastColon === -1) return null;
  return parseIpv4(host.slice(lastColon + 1));
}

function expandIpv6(host: string): number[] | null {
  let input = host.replace(/^\[/, "").replace(/\]$/, "").toLowerCase();
  if (!/^[0-9a-f:.]+$/.test(input)) return null;

  // Rewrite a dotted IPv4 tail (`::ffff:127.0.0.1`) as two hex groups.
  const dotted = embeddedIpv4(input);
  if (dotted) {
    const [a = 0, b = 0, c = 0, d = 0] = dotted;
    const high = ((a << 8) | b).toString(16);
    const low = ((c << 8) | d).toString(16);
    input = `${input.slice(0, input.lastIndexOf(":") + 1)}${high}:${low}`;
  }

  const [headRaw = "", tailRaw] = input.split("::");
  const head = headRaw ? headRaw.split(":").filter(Boolean) : [];
  const tail = tailRaw !== undefined && tailRaw ? tailRaw.split(":").filter(Boolean) : [];
  const missing = 8 - head.length - tail.length;
  if (input.includes("::") && missing < 0) return null;
  if (!input.includes("::") && head.length !== 8) return null;
  const groups = [...head, ...Array<string>(Math.max(0, missing)).fill("0"), ...tail];
  if (groups.length !== 8) return null;
  if (groups.some((group) => !/^[0-9a-f]{1,4}$/.test(group))) return null;

  const bytes: number[] = [];
  for (const group of groups) {
    const value = Number.parseInt(group, 16);
    bytes.push((value >> 8) & 0xff, value & 0xff);
  }
  return bytes;
}

function isPrivateIpv6(host: string): boolean {
  // Block IPv4-embedded/metadata forms explicitly before generic parsing.
  const dotted = embeddedIpv4(host);
  if (dotted) {
    const prefix = host.slice(0, host.lastIndexOf(":")).toLowerCase();
    if (prefix === "::ffff" || prefix === "::" || prefix === "0:0:0:0:0:ffff") {
      return isPrivateIpv4(dotted);
    }
    if (isPrivateIpv4(dotted)) return true;
  }

  const bytes = expandIpv6(host);
  if (!bytes) return true;
  const [b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0, b7 = 0] = bytes;

  if (bytes.every((byte) => byte === 0)) return true; // ::
  if (bytes.slice(0, 7).every((byte) => byte === 0) && b7 === 1) return true; // ::1
  if ((b0 & 0xfe) === 0xfc) return true; // fc00::/7
  if (b0 === 0xfe && (b1 & 0xc0) === 0x80) return true; // fe80::/10
  if (b0 === 0xff) return true; // multicast
  if (b0 === 0x20 && b1 === 0x01 && b2 === 0x0d && b3 === 0xb8) return true; // 2001:db8::/32
  if (b0 === 0x20 && b1 === 0x01 && b2 === 0x00 && b3 === 0x00) return true; // 2001::/32 Teredo
  if (b0 === 0x20 && b1 === 0x02) return true; // 2002::/16 6to4
  if (b0 === 0x00 && b1 === 0x64 && b2 === 0xff && b3 === 0x9b) return true; // NAT64 prefix
  if (b4 === 0xff && b5 === 0xff) return true; // remaining mapped forms
  if (bytes.slice(0, 5).every((byte) => byte === 0) && b5 === 0x0 && b6 === 0x0 && b7 === 0) {
    return true;
  }
  return false;
}

export function validateWebhookUrl(raw: string): UrlValidation {
  const input = String(raw ?? "").trim();
  if (!input) return fail("empty", "Webhook URL is empty");
  if (input.length > 2000) return fail("too-long", "Webhook URL is too long");

  let parsed: URL;
  try {
    parsed = new URL(input);
  } catch {
    return fail("malformed", "Webhook URL is not a valid absolute URL");
  }

  if (parsed.protocol !== "https:" && parsed.protocol !== "http:") {
    return fail("scheme", "Only http:// and https:// webhooks are allowed");
  }
  if (parsed.username || parsed.password) {
    return fail("credentials", "Credentials must not be embedded in the webhook URL");
  }
  if (!parsed.hostname) return fail("host", "Webhook URL has no hostname");

  const host = parsed.hostname.toLowerCase().replace(/\.$/, "");
  const bareHost = host.replace(/^\[/, "").replace(/\]$/, "");

  if (
    bareHost === "localhost" ||
    bareHost.endsWith(".localhost") ||
    bareHost.endsWith(".local") ||
    bareHost.endsWith(".internal") ||
    bareHost.endsWith(".home.arpa") ||
    bareHost.endsWith(".lan") ||
    bareHost === "metadata.google.internal" ||
    bareHost === "instance-data" ||
    bareHost.endsWith(".test") ||
    bareHost.endsWith(".invalid") ||
    bareHost.endsWith(".example")
  ) {
    return fail("private-host", "Local and reserved hostnames are blocked");
  }

  if (!host.includes(":") && !host.includes(".") && !/^\d+$/.test(host)) {
    return fail("single-label", "Single-label intranet hostnames are blocked");
  }

  const ipv4 = parseIpv4(host);
  if (ipv4) {
    if (isPrivateIpv4(ipv4)) return fail("private-ip", "Private or reserved IPv4 addresses are blocked");
  } else if (host.includes(":") || bareHost.includes(":")) {
    const bytes = expandIpv6(bareHost);
    if (!bytes) return fail("private-ip", "Invalid IPv6 address");
    if (isPrivateIpv6(bareHost) || isPrivateIpv4Mapped(bytes)) {
      return fail("private-ip", "Private, loopback or reserved IPv6 addresses are blocked");
    }
  } else if (/^\d+$/.test(host)) {
    return fail("private-ip", "Numeric hostnames are blocked");
  }

  if (parsed.port === "0") return fail("port", "Port 0 is not allowed");

  return { ok: true, url: parsed.toString(), reason: "", code: "" };
}

export function buildWebhookHeaders(secret: string): Record<string, string> {
  const headers: Record<string, string> = {
    "Content-Type": "application/json",
    "X-MadarWA-Event": "webhook",
    "User-Agent": "MadarWA-Extension/1.0",
  };
  const trimmed = String(secret ?? "").trim();
  if (trimmed) headers["X-MadarWA-Secret"] = trimmed.slice(0, 256);
  return headers;
}

/** Constant-time comparison for short secrets/PIN hashes. */
export function timingSafeEqual(a: string, b: string): boolean {
  const left = String(a ?? "");
  const right = String(b ?? "");
  const length = Math.max(left.length, right.length);
  let diff = left.length ^ right.length;
  for (let i = 0; i < length; i += 1) {
    diff |= (left.charCodeAt(i) || 0) ^ (right.charCodeAt(i) || 0);
  }
  return diff === 0;
}
