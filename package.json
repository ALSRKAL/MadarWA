{
  "name": "madarwa",
  "version": "1.0.0",
  "private": true,
  "description": "MadarWA - Enterprise privacy, CRM, automation and broadcasting suite for WhatsApp Web (Manifest V3).",
  "type": "module",
  "license": "MIT",
  "author": "ALSRKAL",
  "homepage": "https://github.com/ALSRKAL/MadarWA#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALSRKAL/MadarWA.git"
  },
  "bugs": {
    "url": "https://github.com/ALSRKAL/MadarWA/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "whatsapp-web",
    "privacy",
    "automation",
    "broadcaster",
    "wppconnect",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@wppconnect/wa-js": "4.7.2",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "^9.3.13",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
